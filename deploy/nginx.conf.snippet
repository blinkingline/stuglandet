# if cloudstuff uses nginx (then run: certbot --nginx -d cabins.geeb.us)
server {
    server_name cabins.geeb.us;
    listen 80;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;       # required for the /ws game socket
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;                      # keep idle games' sockets open
    }
}
